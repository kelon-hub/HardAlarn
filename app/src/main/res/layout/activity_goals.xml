<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="casual"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="Мои цели"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFF59D"
            android:fontFamily="casual"
            android:gravity="top"
            android:hint="Цели на ДЕНЬ..."
            android:minLines="3"
            android:padding="14dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#666666"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etWeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#C8E6C9"
            android:fontFamily="casual"
            android:gravity="top"
            android:hint="Цели на НЕДЕЛЮ..."
            android:minLines="3"
            android:padding="14dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#666666"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#B3E5FC"
            android:fontFamily="casual"
            android:gravity="top"
            android:hint="Цели на МЕСЯЦ..."
            android:minLines="3"
            android:padding="14dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#666666"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#FFE0B2"
            android:fontFamily="casual"
            android:gravity="top"
            android:hint="Цели на ГОД..."
            android:minLines="3"
            android:padding="14dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#666666"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSaveGoals"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="casual"
            android:text="Сохранить и закрыть"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
