}
}
}
private fun stopVisualAnimators() {
sunriseAnimator?.cancel()
brightnessAnimator?.cancel()
}
override fun onDestroy() {
handler.removeCallbacksAndMessages(null)
interphaseTimer?.cancel()
stopVisualAnimators()
AlarmService.stop(this)
super.onDestroy()
}
}
